{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/project.schema.json",
  "title": "Paper Collage Project v12",
  "type": "object",
  "required": ["schemaVersion", "slug", "title", "intake", "styleProfile", "motionContract", "plan", "quality", "video", "theme", "voice", "audio", "editorial", "scenes", "sceneTransitions"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 12},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "intake": {"$ref": "#/$defs/intake"},
    "styleProfile": {
      "oneOf": [
        {"type": "null"},
        {
          "$ref": "https://local.paper-collage.dev/style-profile.schema.json#/$defs/snapshot"
        }
      ]
    },
    "motionContract": {
      "oneOf": [
        {"type": "null"},
        {
          "$ref": "https://local.paper-collage.dev/motion-contract.schema.json#/$defs/compiled"
        }
      ]
    },
    "plan": {"$ref": "#/$defs/plan"},
    "quality": {
      "type": "object",
      "required": ["minimumAssetScale"],
      "properties": {"minimumAssetScale": {"type": "number", "exclusiveMinimum": 0}},
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "theme": {
      "$ref": "https://local.paper-collage.dev/style-profile.schema.json#/$defs/theme"
    },
    "voice": {"$ref": "#/$defs/voice"},
    "audio": {"$ref": "#/$defs/audio"},
    "editorial": {"$ref": "editorial.schema.json#/$defs/editorialProject"},
    "worlds": {"type": "array", "items": {"$ref": "#/$defs/worldContract"}},
    "trajectoryContracts": {"type": "array", "items": {"$ref": "#/$defs/trajectoryContract"}},
    "spatialContracts": {
      "type": "array",
      "items": {
        "$ref": "https://local.paper-collage.dev/spatial-contract.schema.json#/$defs/contract"
      }
    },
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
    "sceneTransitions": {"type": "array", "items": {"$ref": "#/$defs/sceneBoundaryTransition"}}
  },
  "$defs": {
    "intake": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "aspectRatio",
        "visualStylePreset",
        "parallaxPreference",
        "styleCatalogVersion",
        "styleCatalogFingerprint",
        "styleProfileFingerprint",
        "confirmedAt",
        "note",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": {"const": 2},
        "status": {"enum": ["pending", "confirmed"]},
        "aspectRatio": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["16:9", "9:16"]}
          ]
        },
        "visualStylePreset": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          ]
        },
        "parallaxPreference": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["auto", "prefer", "minimal"]}
          ]
        },
        "styleCatalogVersion": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "styleCatalogFingerprint": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          ]
        },
        "styleProfileFingerprint": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          ]
        },
        "confirmedAt": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "note": {"type": "string"},
        "updatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "profilePromise": {
      "type": "object",
      "required": [
        "minRequiredStateFamilies",
        "minEnhancementStateFamilies",
        "minTotalStates",
        "minLocalMotionTargets",
        "minLayeredScenes",
        "minParallaxScenes",
        "minAmbientScenes"
      ],
      "properties": {
        "minRequiredStateFamilies": {"type": "integer", "minimum": 0},
        "minEnhancementStateFamilies": {"type": "integer", "minimum": 0},
        "minTotalStates": {"type": "integer", "minimum": 0},
        "minLocalMotionTargets": {"type": "integer", "minimum": 0},
        "minLayeredScenes": {"type": "integer", "minimum": 0},
        "minParallaxScenes": {"type": "integer", "minimum": 0},
        "minAmbientScenes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "profilePromiseRevision": {
      "type": "object",
      "required": [
        "authorizationId",
        "authorizationFingerprint",
        "lockedSceneIds",
        "original",
        "recalculated",
        "equivalentQualityEvidence",
        "decidedAt"
      ],
      "properties": {
        "authorizationId": {"type": "string", "minLength": 1},
        "authorizationFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lockedSceneIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "original": {"$ref": "#/$defs/profilePromise"},
        "recalculated": {"$ref": "#/$defs/profilePromise"},
        "equivalentQualityEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "decidedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "worldContract": {
      "type": "object",
      "required": ["id", "sceneIds", "requiredStripRoles", "stripSources"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sceneIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requiredStripRoles": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["far", "mid", "ground", "near"]}
        },
        "stripSources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["role", "sourceAssetId"],
            "properties": {
              "role": {"enum": ["far", "mid", "ground", "near"]},
              "sourceAssetId": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trajectoryAssertion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind", "sceneId", "proofTimeId", "nodeId", "stateId"],
          "properties": {
            "id": {"type": "string", "minLength": 1}, "kind": {"const": "state-at"}, "sceneId": {"type": "string", "minLength": 1}, "proofTimeId": {"type": "string", "minLength": 1}, "nodeId": {"type": "string", "minLength": 1}, "stateId": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "sceneId", "proofTimeId", "leadingNodeId", "trailingNodeId", "leadingSide", "minimumGap"],
          "properties": {
            "id": {"type": "string", "minLength": 1}, "kind": {"const": "relative-order"}, "sceneId": {"type": "string", "minLength": 1}, "proofTimeId": {"type": "string", "minLength": 1}, "leadingNodeId": {"type": "string", "minLength": 1}, "trailingNodeId": {"type": "string", "minLength": 1}, "leadingSide": {"enum": ["left", "right"]}, "minimumGap": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "sceneId", "proofTimeId", "nodeId", "fromProofTimeId", "toProofTimeId", "direction", "minimumDelta"],
          "properties": {
            "id": {"type": "string", "minLength": 1}, "kind": {"const": "travel"}, "sceneId": {"type": "string", "minLength": 1}, "proofTimeId": {"type": "string", "minLength": 1}, "nodeId": {"type": "string", "minLength": 1}, "fromProofTimeId": {"type": "string", "minLength": 1}, "toProofTimeId": {"type": "string", "minLength": 1}, "direction": {"enum": ["left", "right"]}, "minimumDelta": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "sceneId", "proofTimeId", "nodeId", "fromProofTimeId", "direction", "minimumDelta"],
          "properties": {
            "id": {"type": "string", "minLength": 1}, "kind": {"const": "monotonic-travel"}, "sceneId": {"type": "string", "minLength": 1}, "proofTimeId": {"type": "string", "minLength": 1}, "nodeId": {"type": "string", "minLength": 1}, "fromProofTimeId": {"type": "string", "minLength": 1}, "direction": {"enum": ["left", "right"]}, "minimumDelta": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "sceneId", "proofTimeId", "nodeId", "side"],
          "properties": {
            "id": {"type": "string", "minLength": 1}, "kind": {"const": "offscreen-at"}, "sceneId": {"type": "string", "minLength": 1}, "proofTimeId": {"type": "string", "minLength": 1}, "nodeId": {"type": "string", "minLength": 1}, "side": {"enum": ["left", "right"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "trajectoryContract": {
      "type": "object",
      "required": ["id", "assertions", "sequence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trajectoryAssertion"}},
        "sequence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "providerRoot": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "role",
        "sceneId",
        "sourcePackageId",
        "sourceStrategy",
        "poseFamilyId"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["style-proof", "source-package", "pose-sheet"]},
        "role": {"type": "string", "minLength": 1},
        "sceneId": {"type": ["string", "null"]},
        "sourcePackageId": {"type": ["string", "null"]},
        "sourceStrategy": {
          "oneOf": [
            {"type": "null"},
            {
              "enum": [
                "single-background",
                "rigid-master",
                "registered-layer-sheet",
                "context-preserving-layer-edits",
                "canonical-frame-with-content-sheet"
              ]
            }
          ]
        },
        "poseFamilyId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "providerRootPlan": {
      "type": "object",
      "required": ["schemaVersion", "roots", "fingerprint"],
      "properties": {
        "schemaVersion": {"const": 1},
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/providerRoot"}
        },
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": ["schemaVersion", "slug", "status", "inputMode", "productionProfile", "assetBudget", "motionBudget", "approvedImageBudget", "requested", "resolved", "updatedAt"],
      "properties": {
        "schemaVersion": {"const": 4},
        "slug": {"type": "string"},
        "status": {"enum": ["pending", "resolved"]},
        "inputMode": {"enum": ["none", "duration-only", "scenes-only", "both"]},
        "productionProfile": {"enum": ["draft", "balanced", "full-depth"]},
        "storyScope": {
          "enum": ["concise", "standard", "expanded"]
        },
        "scenarioBinding": {
          "type": "object",
          "required": [
            "scenarioSetFingerprint",
            "optionId",
            "optionFingerprint",
            "expectedProviderImageCalls",
            "proposedImageAttemptLimit",
            "providerRootPlan",
            "selectedAt"
          ],
          "properties": {
            "scenarioSetFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "optionId": {"enum": ["draft", "balanced", "full-depth"]},
            "optionFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "expectedProviderImageCalls": {"type": "integer", "minimum": 1},
            "proposedImageAttemptLimit": {"type": "integer", "minimum": 1},
            "providerRootPlan": {"$ref": "#/$defs/providerRootPlan"},
            "selectedAt": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "profilePromise": {"$ref": "#/$defs/profilePromise"},
        "profilePromiseRevision": {"$ref": "#/$defs/profilePromiseRevision"},
        "assetBudget": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["backgrounds", "environmentLayers", "characterSheets", "styleSamples", "baseImageAttempts", "layerPackageAttemptReserve", "maxGeneratedImages"],
              "properties": {
                "backgrounds": {"type": "integer", "minimum": 0},
                "environmentLayers": {"type": "integer", "minimum": 0},
                "characterSheets": {"type": "integer", "minimum": 0},
                "styleSamples": {"type": "integer", "minimum": 0},
                "baseImageAttempts": {"type": "integer", "minimum": 0},
                "layerPackageAttemptReserve": {"type": "integer", "minimum": 0},
                "maxGeneratedImages": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          ]
        },
        "motionBudget": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["maxPoseSheetCalls", "maxStatesPerSheet", "maxContinuousTargets"],
              "properties": {
                "maxPoseSheetCalls": {"type": "integer", "minimum": 1},
                "maxStatesPerSheet": {"type": "integer", "minimum": 2},
                "maxContinuousTargets": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          ]
        },
        "approvedImageBudget": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["imageAttemptLimit", "expectedProviderImageCalls", "profileHardCeiling", "approvedAt"],
              "properties": {
                "imageAttemptLimit": {"type": "integer", "minimum": 0},
                "expectedProviderImageCalls": {"type": "integer", "minimum": 0},
                "profileHardCeiling": {"type": "integer", "minimum": 0},
                "approvedAt": {"type": "string", "format": "date-time"}
              },
              "additionalProperties": false
            }
          ]
        },
        "imageBudgetRevisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "schemaVersion",
              "fromLimit",
              "toLimit",
              "usedAtApproval",
              "reservedAtApproval",
              "profileHardCeiling",
              "authorizedAt",
              "humanNote"
            ],
            "properties": {
              "schemaVersion": {"const": 1},
              "fromLimit": {"type": "integer", "minimum": 0},
              "toLimit": {"type": "integer", "minimum": 0},
              "usedAtApproval": {"type": "integer", "minimum": 0},
              "reservedAtApproval": {"type": "integer", "minimum": 0},
              "profileHardCeiling": {"type": "integer", "minimum": 0},
              "authorizedAt": {"type": "string", "format": "date-time"},
              "humanNote": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "requested": {
          "type": "object",
          "required": ["durationSeconds", "sceneCount"],
          "properties": {
            "durationSeconds": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
            "sceneCount": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}
          },
          "additionalProperties": false
        },
        "resolved": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["durationSeconds", "sceneCount", "estimatedNarrationSeconds", "rationale", "resolvedAt"],
              "properties": {
                "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
                "sceneCount": {"type": "integer", "minimum": 1},
                "estimatedNarrationSeconds": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
                "rationale": {"type": "string", "minLength": 1},
                "resolvedAt": {"type": "string", "format": "date-time"}
              },
              "additionalProperties": false
            }
          ]
        },
        "updatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["fictional", "clone"]},
        "provider": {"type": "string"},
        "voiceId": {"type": "string"},
        "profile": {"type": "string"},
        "displayName": {"type": "string"},
        "settings": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
      },
      "additionalProperties": false
    },
    "sound": {
      "type": "object",
      "required": ["src", "volume"],
      "properties": {
        "src": {"type": "string", "minLength": 1},
        "volume": {"type": "number", "minimum": 0, "maximum": 4}
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "required": ["narration", "music", "mastering"],
      "properties": {
        "narration": {
          "type": "object",
          "required": ["volume"],
          "properties": {"volume": {"type": "number", "exclusiveMinimum": 0, "maximum": 4}},
          "additionalProperties": false
        },
        "music": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sound"}]},
        "mastering": {
          "type": "object",
          "required": ["targetLufs", "toleranceLufs", "truePeakDbtp"],
          "properties": {
            "targetLufs": {"type": "number"},
            "toleranceLufs": {"type": "number", "exclusiveMinimum": 0},
            "truePeakDbtp": {"type": "number"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "proofTime": {
      "type": "object",
      "required": ["id", "at", "label", "kind", "assertions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "at": {"type": "number", "minimum": 0, "maximum": 1},
        "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["establish", "action", "peak", "final"]},
        "assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "stateAssertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["nodeId", "stateId"],
            "properties": {
              "nodeId": {"type": "string", "minLength": 1},
              "stateId": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "visibilityVisual": {
      "type": "object",
      "required": ["kind", "action", "transition", "durationSeconds"],
      "properties": {
        "kind": {"const": "visibility"},
        "action": {"enum": ["show", "hide"]},
        "transition": {"enum": ["cut", "fade-rise", "fade-scale"]},
        "durationSeconds": {"type": "number", "minimum": 0, "maximum": 2}
      },
      "allOf": [
        {"if": {"properties": {"transition": {"const": "cut"}}}, "then": {"properties": {"durationSeconds": {"const": 0}}}},
        {"if": {"properties": {"transition": {"enum": ["fade-rise", "fade-scale"]}}}, "then": {"properties": {"durationSeconds": {"exclusiveMinimum": 0}}}}
      ],
      "additionalProperties": false
    },
    "emphasisVisual": {
      "type": "object",
      "required": ["kind", "action", "durationSeconds", "intensity"],
      "properties": {
        "kind": {"const": "emphasis"},
        "action": {"$ref": "composition.schema.json#/$defs/emphasisAction"},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "intensity": {"type": "number", "minimum": 0, "maximum": 3}
      },
      "additionalProperties": false
    },
    "holdVisual": {
      "type": "object",
      "required": ["kind", "durationSeconds"],
      "properties": {
        "kind": {"const": "hold"},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "beatId", "at", "targetId", "visual"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "beatId": {"type": "string", "minLength": 1},
        "at": {"type": "number", "minimum": 0, "maximum": 1},
        "targetId": {"type": "string", "minLength": 1},
        "visual": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/visibilityVisual"}, {"$ref": "#/$defs/emphasisVisual"}, {"$ref": "#/$defs/holdVisual"}]},
        "proofTimeId": {"type": "string", "minLength": 1},
        "encounter": {
          "$ref": "https://local.paper-collage.dev/encounter-contract.schema.json#/$defs/eventBinding"
        },
        "sound": {"$ref": "#/$defs/sound"}
      },
      "additionalProperties": false
    },
    "sceneBoundaryTransition": {
      "type": "object",
      "required": ["id", "fromSceneId", "toSceneId", "intent", "rationale", "treatment"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fromSceneId": {"type": "string", "minLength": 1},
        "toSceneId": {"type": "string", "minLength": 1},
        "intent": {"enum": ["continuity", "location-change", "time-passage", "focus-reveal", "chapter-reset", "impact"]},
        "rationale": {"type": "string", "minLength": 1},
        "treatment": {"$ref": "#/$defs/sceneBoundaryTreatment"}
      },
      "additionalProperties": false
    },
    "sceneBoundaryTreatment": {
      "type": "object",
      "required": ["type", "motivation", "durationSeconds"],
      "properties": {
        "type": {"enum": ["cut", "wipe", "dip", "slide", "iris", "page-turn", "shutters"]},
        "motivation": {"enum": ["semantic-default", "authored", "rhythmic", "impact"]},
        "durationSeconds": {"type": "number", "minimum": 0, "maximum": 1.5},
        "edgeStyle": {"enum": ["clean", "paper", "torn"]},
        "direction": {"enum": ["left-to-right", "right-to-left", "top-to-bottom", "bottom-to-top"]},
        "beatId": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "cut"}}}, "then": {"properties": {"durationSeconds": {"const": 0}, "motivation": {"enum": ["rhythmic", "impact"]}}, "not": {"anyOf": [{"required": ["direction"]}, {"required": ["edgeStyle"]}]}}},
        {"if": {"not": {"properties": {"type": {"const": "cut"}}}}, "then": {"required": ["edgeStyle"]}},
        {"if": {"properties": {"motivation": {"const": "rhythmic"}}}, "then": {"required": ["beatId"], "properties": {"type": {"const": "cut"}}}},
        {"if": {"properties": {"motivation": {"const": "impact"}}}, "then": {"properties": {"type": {"const": "cut"}}}},
        {"if": {"properties": {"type": {"const": "wipe"}}}, "then": {"required": ["direction"], "properties": {"durationSeconds": {"minimum": 0.2}, "motivation": {"enum": ["semantic-default", "authored"]}}, "not": {"required": ["beatId"]}}},
        {"if": {"required": ["edgeStyle"], "properties": {"edgeStyle": {"const": "torn"}}}, "then": {"properties": {"type": {"const": "wipe"}}}},
        {"if": {"properties": {"type": {"const": "dip"}}}, "then": {"properties": {"durationSeconds": {"minimum": 0.3}, "motivation": {"enum": ["semantic-default", "authored"]}}, "not": {"anyOf": [{"required": ["direction"]}, {"required": ["beatId"]}]}}},
        {"if": {"properties": {"type": {"const": "slide"}}}, "then": {"required": ["direction"], "properties": {"durationSeconds": {"minimum": 0.25}, "motivation": {"enum": ["semantic-default", "authored"]}}, "not": {"required": ["beatId"]}}},
        {"if": {"properties": {"type": {"const": "iris"}}}, "then": {"properties": {"durationSeconds": {"minimum": 0.3}, "motivation": {"enum": ["semantic-default", "authored"]}}, "not": {"anyOf": [{"required": ["direction"]}, {"required": ["beatId"]}]}}},
        {"if": {"properties": {"type": {"const": "page-turn"}}}, "then": {"required": ["direction"], "properties": {"durationSeconds": {"minimum": 0.4}, "direction": {"enum": ["left-to-right", "right-to-left"]}, "motivation": {"enum": ["semantic-default", "authored"]}}, "not": {"required": ["beatId"]}}},
        {"if": {"properties": {"type": {"const": "shutters"}}}, "then": {"properties": {"durationSeconds": {"minimum": 0.4}, "motivation": {"enum": ["semantic-default", "authored"]}}, "not": {"anyOf": [{"required": ["direction"]}, {"required": ["beatId"]}]}}}
      ],
