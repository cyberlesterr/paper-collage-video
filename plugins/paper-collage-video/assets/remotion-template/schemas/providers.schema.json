{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/providers.schema.json",
  "title": "Paper Collage Provider Configuration",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "capabilities": {
      "type": "object",
      "properties": {
        "text": {"$ref": "#/$defs/capability"},
        "image": {"$ref": "#/$defs/capability"},
        "voice": {"$ref": "#/$defs/capability"},
        "sound": {"$ref": "#/$defs/capability"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type": "object",
      "properties": {
        "defaultProvider": {"type": "string", "minLength": 1},
        "providers": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/provider"}
        },
        "selection": {"$ref": "#/$defs/selection"}
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": ["label", "adapter"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "adapter": {"enum": ["host", "command", "manual"]},
        "tool": {"type": "string", "minLength": 1},
        "toolHint": {"type": "string"},
        "model": {"type": "string"},
        "outputAcquisition": {
          "type": "object",
          "required": ["mode", "evidence", "verifiedAt"],
          "properties": {
            "mode": {
              "enum": ["local-file", "public-download-url"]
            },
            "evidence": {"type": "string", "minLength": 1},
            "verifiedAt": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "invocation": {
          "type": "object",
          "properties": {
            "providerValue": {"type": "string", "minLength": 1},
            "modelValue": {"type": "string", "minLength": 1},
            "reportedModelAliases": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "requiredEnv": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "uniqueItems": true
        },
        "nativeCanvas": {
          "type": "object",
          "description": "Image provider returns its own native canvas; requests without an explicit providerSource are auto-observed and deterministically normalized to the request canvas instead of being rejected after the paid call.",
          "required": ["minimumWidth", "minimumHeight", "aspectRatioTolerance"],
          "properties": {
            "minimumWidth": {"type": "integer", "minimum": 2},
            "minimumHeight": {"type": "integer", "minimum": 2},
            "aspectRatioTolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5}
          },
          "additionalProperties": false
        },
        "command": {
          "type": "object",
          "required": ["executable", "args"],
          "properties": {
            "executable": {"type": "string", "minLength": 1},
            "args": {"type": "array", "items": {"type": "string"}},
            "cwd": {"type": "string"},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["status", "provider", "confirmedAt", "scope", "note"],
      "properties": {
        "status": {"const": "confirmed"},
        "provider": {"type": "string", "minLength": 1},
        "confirmedAt": {"type": "string", "format": "date-time"},
        "scope": {"enum": ["project", "workspace"]},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
